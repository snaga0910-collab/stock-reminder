# このファイルをコピーして .env.local を作り、それぞれの値を入れてください。
# .env.local は Git 管理対象外です（秘密情報を公開しないため）。

# --- Supabase（⚙️設定 → API Keys / Data API） ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 秘密キー。サーバー側でのみ使用する
SUPABASE_SECRET_KEY=

# --- LINE（LINE Developers → Messaging API設定 / チャネル基本設定） ---
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=

# --- 定時通知の保護用（任意の長い文字列。例: openssl rand -hex 32） ---
CRON_SECRET=

# --- アプリに入るための合言葉（好きな英数字） ---
APP_PASSCODE=
